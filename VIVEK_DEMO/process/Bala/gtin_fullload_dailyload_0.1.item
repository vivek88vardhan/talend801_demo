    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (context.vModifiedDate != null &amp;&amp; context.vPriorToDate != null &amp;&amp; !context.vModifiedDate.isEmpty() ) {&#xA;&#x9;context.vURLSuffix = &quot;modifiedDatePriorTo=&quot;+context.vPriorToDate+&quot;&amp;modifiedDateStartFrom=&quot;+ context.vModifiedDate;&#xA;&#x9;System.out.println(context.vURLSuffix);&#xA;} else if ( context.vModifiedDate.isEmpty()) {&#xA;&#x9;if (context.vUseIncrementLogic &amp;&amp; context.vPriorToNumberOfDays != null &amp;&amp; context.vPriorToNumberOfDays > 0  ) {&#xA;&#x9;&#x9;context.vURLSuffix = &quot;modifiedDateStartFrom=&quot;+TalendDate.addDate(TalendDate.getDate(&quot;yyyy-MM-dd&quot;), &quot;yyyy-MM-dd&quot;, -context.vPriorToNumberOfDays, &quot;dd&quot;)+&quot;&amp;modifiedDatePriorTo=&quot;+ TalendDate.getDate(&quot;yyyy-MM-dd&quot;);&#xA;&#x9;&#x9;System.out.println(context.vURLSuffix);&#xA;&#x9;} else {&#xA;&#x9;&#x9;context.vURLSuffix = &quot;modifiedDatePriorTo=&quot;+context.vPriorToDate;&#xA;&#x9;&#x9;System.out.println(context.vURLSuffix);&#xA;&#x9;}&#xA;&#x9;&#xA;&#x9;&#xA;}"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
